{
  "name": "carleton-smart-scheduler",
  "version": "0.1.0",
  "description": "Smart Scheduler for Carleton Engineering Students",
  "scripts": {
    "db:setup": "prisma generate && prisma db push",
    "db:reset": "prisma db push --force-reset",
    "db:seed": "tsx scripts/seed.ts",
    "db:import-timetable": "tsx scripts/import-timetable.ts",
    "cli": "tsx cli/index.ts",
    "server": "tsx watch server/index.ts",
    "server:build": "tsc -p tsconfig.server.json",
    "server:start": "node dist/server/index.js"
  },
  "dependencies": {
    "@prisma/client": "5.22.0",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "multer": "^1.4.5-lts.1",
    "pdfreader": "^3.0.8",
    "prisma": "^5.7.0",
    "typescript": "^5.0.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.0.0",
    "tsx": "^4.6.0"
  }
}